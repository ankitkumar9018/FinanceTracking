# ============================================================
# FinanceTracker Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values you need.
# All values shown below are defaults — only override what you
# need to change.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=FinanceTracker
APP_VERSION=1.0.0
DEBUG=true
# Root log level: CRITICAL | ERROR | WARNING | INFO | DEBUG.
# Read at startup by app/core/logging_config.py (from this file or the
# environment). The `audit` logger stays at INFO regardless, so raising this
# to WARNING can never silently switch the security audit trail off.
LOG_LEVEL=INFO
# NOTE: the backend takes its port from `python -m app --port N` (default
# 8420, auto-advancing if busy) — API_PORT here is NOT read. Kept out of this
# file on purpose so it can't look like a working knob.

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Token expiration (minutes / days)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────
# SQLite (default, development):
DATABASE_URL=sqlite+aiosqlite:///./finance.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/financetracker
# DATABASE_POOL_SIZE=5

# ── Redis (optional — app works without it) ──────────────────
REDIS_URL=redis://localhost:6379

# ── Market Data ──────────────────────────────────────────────
PRICE_REFRESH_INTERVAL=5
DEFAULT_CHART_DAYS=30
# (Market hours are NOT configurable: the real per-exchange sessions used by
# the staleness logic live in app/services/freshness_service.py.)

# ── Email Notifications (SendGrid) ───────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=

# ── SMS / WhatsApp (Twilio) ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI / LLM ────────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ── Broker APIs ──────────────────────────────────────────────
# Not read at startup: broker credentials are entered in the app (Settings →
# Brokers), Fernet-encrypted and stored per connection. Kept here only as a
# reminder of which keys each broker needs.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ICICI_APP_KEY=
ICICI_SECRET_KEY=

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:1420,https://tauri.localhost

# ── Alerts ──────────────────────────────────────────────────
ALERT_CHECK_INTERVAL=60

# Removed from this file because nothing read them (they were silently
# dropped by Settings' extra="ignore", or were fields no code consulted):
#   MFAPI_URL             — the mfapi.in base URL is fixed in the MF service
#   NOTIFICATION_CHANNELS — channels are enabled by configuring their creds
#   DEFAULT_CURRENCY      — new accounts default to INR in the User model
#   DEFAULT_THEME         — new accounts default to dark in the User model
